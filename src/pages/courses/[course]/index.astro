---
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await getCollection('courses');
  return courses.map(course => ({
    params: { course: course.slug },
    props: { course },
  }));
};

const { course } = Astro.props;
const { title, shortName, semester, color, moodleUrl, scheduleUrl, sections } = course.data;

const hasSections = Array.isArray(sections) && sections.length > 0;
---

<CourseLayout
  title={title}
  courseSlug={course.slug}
  courseTitle={title}
  courseColor={color}
  currentSection="overview"
  description={`Moodle and schedule links for ${title}.`}
>
  <div class="course-header" style={`--course-color: ${color}`}>
    <span class="course-badge">{shortName}</span>
    <h1>{title}</h1>
    <p class="course-semester">{semester}</p>
  </div>

  <p class="course-notice" data-i18n="courses.movedToMoodle">
    This course is now run through Moodle. Class materials and activities are managed there.
  </p>

  {hasSections ? (
    <div class="section-grid">
      {sections!.map(section => (
        <div class="card section-card">
          <h2>{section.label}</h2>
          <div class="link-row">
            <a href={section.moodleUrl} target="_blank" rel="noopener" class="btn btn-primary" data-i18n="courses.accessMoodle">Access on Moodle</a>
            <a href={section.scheduleUrl ?? scheduleUrl} target="_blank" rel="noopener" class="btn" data-i18n="courses.viewSchedule">View Schedule</a>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="card link-row">
      {moodleUrl && <a href={moodleUrl} target="_blank" rel="noopener" class="btn btn-primary" data-i18n="courses.accessMoodle">Access on Moodle</a>}
      {scheduleUrl && <a href={scheduleUrl} target="_blank" rel="noopener" class="btn" data-i18n="courses.viewSchedule">View Schedule</a>}
    </div>
  )}
</CourseLayout>

<style>
  .course-header {
    margin-bottom: var(--space-6);
  }

  .course-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: 700;
    background: var(--course-color);
    color: #fff;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }

  .course-semester {
    color: var(--color-text-muted);
  }

  .course-notice {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    max-width: 600px;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .link-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
</style>
